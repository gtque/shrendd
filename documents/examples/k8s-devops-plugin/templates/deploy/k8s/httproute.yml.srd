apiVersion: gateway.networking.k8s.io/v1beta1
kind: HTTPRoute
metadata:
  name: k8sgames-server
  namespace: k8sgames
  labels:
    app.kubernetes.io/instance: k8sgames-server
    app.kubernetes.io/name: "k8sgames-server"
spec:
  parentRefs:
  - name: k8sgames
  hostnames:
  - "k8sgames.tech"
  - "www.k8sgames.tech"
  rules:
  - matches:
    - path:
        type: PathPrefix
        value: /
  - backendRefs:
    - name: k8sgames-server
      port: 80