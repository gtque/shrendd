kind: ClusterRole
apiVersion: rbac.authorization.k8s.io/v1
metadata:
  name: "k8sgames-server"
  namespace: "k8sgames"
  labels:
    app.kubernetes.io/name: "k8sgames-server"
    app.kubernetes.io/managed-by: "k8sgames"
    app.kubernetes.io/version: "0.0.1"
    app.kubernetes.io/component: "server"
    app.kubernetes.io/part-of: "k8sgames"
rules:
  - apiGroups: [""]
    resources: ["endpoints", "services", "pods", "deployments", "configmaps", "secrets"]
    verbs: ["get", "list", "watch"]
